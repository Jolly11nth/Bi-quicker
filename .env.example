# Railway PostgreSQL injects DATABASE_URL into the backend service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required in production. Generate a long random value and keep it only in Railway Variables.
SESSION_SECRET=replace-with-a-long-random-secret

# Paystack server secret. NEVER expose this as a VITE_ variable or commit a real key.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Optional: fully qualified URL used by Paystack after checkout.
# Example: https://your-railway-domain.up.railway.app/?payment=callback
PAYSTACK_CALLBACK_URL=

# Leave empty for the Railway single-service deployment so the browser uses same-origin /api routes.
# Set this only if the API is deployed as a separate public service.
VITE_API_BASE_URL=
